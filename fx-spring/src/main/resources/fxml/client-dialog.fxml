<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.beautysalon.fx.controller.ClientDialogController"
      spacing="12" prefWidth="360">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label text="Имя:"/>
    <TextField fx:id="nameField" promptText="Полное имя"/>

    <Label text="Телефон:"/>
    <TextField fx:id="phoneField" promptText="+7XXXXXXXXXX"/>

    <Label text="Пароль:"/>
    <PasswordField fx:id="passwordField" promptText="Минимум 6 символов"/>
    <Label fx:id="passwordHint" text="(Пароль при редактировании не меняется)"
           styleClass="hint-label" visible="false" managed="false"/>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Отмена" styleClass="button-secondary" onAction="#onCancel"/>
        <Button text="Сохранить" onAction="#onSave"/>
    </HBox>
</VBox>
