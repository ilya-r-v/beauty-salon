<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.beautysalon.fx.controller.BookingDialogController"
      spacing="14" prefWidth="420">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label text="Клиент:"/>
    <ComboBox fx:id="clientCombo" maxWidth="Infinity"/>

    <Label text="Свободный слот (мастер + время):"/>
    <ComboBox fx:id="slotCombo" maxWidth="Infinity"/>

    <Label text="Вариант услуги:"/>
    <ComboBox fx:id="variantCombo" maxWidth="Infinity"/>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Отмена" styleClass="button-secondary" onAction="#onCancel"/>
        <Button text="Сохранить" onAction="#onSave"/>
    </HBox>
</VBox>
