<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Экран регистрации нового клиента. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.beautysalon.fx.controller.RegisterController"
      spacing="8" styleClass="auth-box">
    <padding>
        <Insets top="20" right="32" bottom="20" left="32"/>
    </padding>

    <Label text="Регистрация" styleClass="header-label"/>

    <Label text="Имя:"/>
    <TextField fx:id="nameField"/>

    <Label text="Телефон:"/>
    <TextField fx:id="phoneField" promptText="+79991234567"/>

    <Label text="Пароль (не короче 6 символов):"/>
    <PasswordField fx:id="passwordField"/>

    <Label text="Повторите пароль:"/>
    <PasswordField fx:id="confirmField" onAction="#onRegister"/>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

    <Button text="Зарегистрироваться" maxWidth="Infinity" defaultButton="true" onAction="#onRegister"/>
    <Button text="Назад ко входу" maxWidth="Infinity" styleClass="button-secondary" onAction="#onBack"/>
</VBox>
