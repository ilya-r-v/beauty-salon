<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Экран входа. Открывается первым при запуске приложения. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.beautysalon.fx.controller.LoginController"
      spacing="10" styleClass="auth-box">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32"/>
    </padding>

    <Label text="Салон красоты" styleClass="header-label"/>
    <Label text="Вход в систему" styleClass="auth-subtitle"/>

    <Label text="Телефон:"/>
    <TextField fx:id="phoneField" promptText="+79991234567" onAction="#onLogin"/>

    <Label text="Пароль:"/>
    <PasswordField fx:id="passwordField" onAction="#onLogin"/>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

    <Button text="Войти" maxWidth="Infinity" defaultButton="true" onAction="#onLogin"/>
    <Button text="Регистрация" maxWidth="Infinity" styleClass="button-secondary" onAction="#onOpenRegister"/>
</VBox>
